ENVIRONMENT=dev
DEBUG=false
LOG_LEVEL=INFO
{%- if cookiecutter.database == "postgresql" %}
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app
{%- elif cookiecutter.database == "mysql" %}
DATABASE_URL=mysql+aiomysql://app:app@localhost:3306/app
{%- else %}
DATABASE_URL=sqlite+aiosqlite:///./app.db
{%- endif %}
CORS_ORIGINS=[]
ALLOWED_HOSTS=["*"]
RATE_LIMIT_PER_MINUTE=120
{%- if cookiecutter.use_redis == "y" %}
REDIS_URL=redis://localhost:6379/0
{%- endif %}
{%- if cookiecutter.use_auth == "y" %}
# Required. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app refuses to start outside dev with this placeholder or anything under 32 chars.
SECRET_KEY=change-me
FIRST_SUPERUSER_EMAIL=
FIRST_SUPERUSER_PASSWORD=
{%- endif %}
{%- if cookiecutter.use_auth == "y" and (cookiecutter.use_auth_jwt_bearer == "y" or cookiecutter.use_auth_jwt_cookie == "y") %}
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
{%- endif %}
{%- if cookiecutter.use_auth == "y" and cookiecutter.use_auth_jwt_cookie == "y" %}
# Auth cookie attributes. COOKIE_SECURE must be true outside dev (HTTPS only).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
{%- endif %}
